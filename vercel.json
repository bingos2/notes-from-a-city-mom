{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/shop/my-babys-little-days",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/tools/my-babys-little-days/editor",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/tools/my-babys-little-days/sandbox-checkout",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/shop/review-moderation",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/journal-invite",
      "destination": "/api/journal-checkout?journalRoute=invite"
    },
    {
      "source": "/api/journal-reviews",
      "destination": "/api/journal-checkout?journalRoute=reviews"
    },
    {
      "source": "/newsletters/why-does-my-toddler-scream-so-much",
      "destination": "/api/screaming-newsletter"
    },
    {
      "source": "/newsletters/my-1-year-old-isnt-walking-yet",
      "destination": "/api/walking-newsletter"
    },
    {
      "source": "/newsletters/why-does-my-toddler-bang-his-head",
      "destination": "/api/head-banging-newsletter"
    },
    {
      "source": "/shop/my-babys-little-days",
      "destination": "/tools/my-babys-little-days/editor"
    }
  ]
}
