{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/newsletters/my-1-year-old-isnt-walking-yet",
      "destination": "/api/walking-newsletter"
    },
    {
      "source": "/newsletters/why-does-my-toddler-bang-his-head",
      "destination": "/api/head-banging-newsletter"
    }
  ]
}
