# Set these in Vercel Project Settings → Environment Variables. Do not commit real values.
RESEND_API_KEY=
SUBSCRIBE_TOKEN_SECRET=
SITE_URL=https://citymomnotes.com

# Required for durable, atomic one-time Welcome-event claims.
# Recommended: connect Upstash Redis through the Vercel Marketplace.
# Vercel injects UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN automatically.
# Alternatively, map the same values to the two NCFM variables below.
NCFM_WELCOME_KV_REST_API_URL=
NCFM_WELCOME_KV_REST_API_TOKEN=

# Optional delivery overrides.
NCFM_FROM_EMAIL=Notes from a City Mom <hello@citymomnotes.com>
RESEND_FREE_GUIDE_TEMPLATE_ID=4c247693-1c61-49a0-a3c3-87f726baf4a8
LITTLE_WINS_A4_PDF_URL=https://citymomnotes.com/downloads/My_Toddlers_Little_Wins_15_Months.pdf
